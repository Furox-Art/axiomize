{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Furox-Art/quantum-reasoning-skill/blob/main/benchmark/schemas/case.schema.json",
  "title": "Quantum Reasoning benchmark case",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "domain", "prompt", "accepted_answers"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "accepted_answers": {
      "type": "array",
      "minItems": 1,
      "items": {}
    },
    "source": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]}
  }
}
