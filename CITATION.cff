date-released: "2026-10-09"
license: MIT
repository-code: "https://github.com/Furox-Art/axiomize"
url: "https://github.com/Furox-Art/axiomize"
keywords:
  - scientific modeling
  - reproducibility
  - dimensional analysis
  - numerical verification
  - uncertainty quantification
  - causal inference
  - model IR
  - agent skills
