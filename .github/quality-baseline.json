{
  "$comment": [
    "Recorded quality-gate baselines. `.github/scripts/quality_ratchet.py` fails",
    "when any measured value gets worse than the number recorded here, and passes",
    "when it improves. This lets the gates be enforced on every PR without",
    "requiring the pre-existing backlog to be fixed first.",
    "Regenerate deliberately with: python .github/scripts/quality_ratchet.py --update-baseline"
  ],
  "tool_versions": {
    "ruff": "0.16.9",
    "mypy": "2.3.1"
  },
  "ruff": {
    "select": [
      "E4",
      "E7",
      "E9",
      "F",
      "B",
      "SIM",
      "I",
      "UP"
    ],
    "ignore": [
      "E701",
      "E702",
      "E741"
    ],
    "max_errors": 81
  },
  "mypy": {
    "targets": [
      "src/axiomize"
    ],
    "max_errors": 35
  },
  "coverage": {
    "min_percent": 69.4
  }
}
